{
  "expo": {
    "name": "DisasterGuardian",
    "slug": "DisasterGuardian",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow DisasterGuardian to access your location for local hazard status and nearby support guidance."
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#171717"
        }
      ],
      "expo-status-bar",
      "expo-font"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": ["android.permission.ACCESS_COARSE_LOCATION", "android.permission.ACCESS_FINE_LOCATION"],
      "package": "com.quintenscholtes.DisasterGuardian"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
